TEST_SERIES = {
    "tensile test": {
        "key": "tensile",
        "name": "Tensile test",
    },

    "impact bend test": {
        "key": "impact",
        "name": "Impact bend test",
    },

    "brinell hardness test": {
        "key": "hardness",
        "name": "Brinell hardness test",
    },
}


# ============================================================
# POMOCNÉ FUNKCE
# ============================================================

def first(value: Any, default: str = "") -> Any:
    """
    Crawler ukládá některé hodnoty jako list.

    Např.:
        "order_number": ["55/26/C"]

    Vrátíme:
        "55/26/C"
    """

    if isinstance(value, list):
        if not value:
            return default

        return value[0]

    if value is None:
        return default

    return value


def text(value: Any) -> str:
    """
    Bezpečný převod na text.
    """

    if value is None:
        return ""

    return str(value)


def slug(value: Any) -> str:
    """
    Bezpečný fragment pro ID.
    """

    value = text(value)

    value = value.replace("/", "_")
    value = value.replace("\\", "_")

    value = re.sub(
        r"[^A-Za-z0-9_-]+",
        "_",
        value,
    )

    value = re.sub(
        r"_+",
        "_",
        value,
    )

    return value.strip("_")


def number(value: Any) -> Any:
    """
    Převádí české desetinné čárky:

        "9,99" -> 9.99
        "24"   -> 24

    Pokud převod nejde, vrátí původní hodnotu.
    """

    if value is None:
        return value

    if isinstance(value, (int, float)):
        return value

    value = str(value).strip()

    if not value:
        return value

    normalized = value.replace(",", ".")

    try:
        result = float(normalized)

    except ValueError:
        return value

    if result.is_integer():
        return int(result)

    return result


def header_value(
    header: dict,
    key: str,
    default: str = "",
) -> Any:

    return first(
        header.get(key),
        default,
    )


def attribute(
    property_name: str,
    value: Any,
    unit: str | None = None,
    value_type: str | None = None,
    valuetype: str | None = None,
) -> dict:
    """
    Vytvoří EDA attribute.
    """

    result = {
        "property": property_name,
        "value": value,
    }

    if unit is not None:
        result["unit"] = unit

    if value_type is not None:
        result["type"] = value_type

    if valuetype is not None:
        result["valuetype"] = valuetype

    return result


# ============================================================
# ZJIŠTĚNÍ TYPU TESTU
# ============================================================

def get_test_series_info(
    method: dict,
) -> tuple[str, str]:

    method_name = text(
        method.get("name")
    ).strip().lower()

    info = TEST_SERIES.get(
        method_name
    )

    if info is None:

        raise ValueError(
            f"Neznámý typ testu: "
            f"'{method.get('name')}'. "
            f"Povolené typy jsou: "
            f"Tensile test, "
            f"Impact bend test, "
            f"Brinell hardness test."
        )

    return (
        info["key"],
        info["name"],
    )


# ============================================================
# LAB ORDER
# ============================================================

def create_lab_order(
    record: dict,
    order_number: str,
) -> dict:

    header = record.get(
        "header",
        {},
    )

    order_id = slug(
        order_number
    )

    lab_order = {

        "_id":
            f"auto:LabOrder{order_id}",

        "itemid":
            f"auto:LabOrder{order_id}",

        "type":
            "generic_order",

        "treetags": [
            "toplevel",
            "Lab Orders",
        ],

        "viewtags": [
            "_generic",
        ],

        "name":
            order_number,

        "attributes": [],

        "link_id":
            f"cpf_order_{order_number}",

        "visible_":
            "all",

        "permission_group":
            "allreadonly",

        "version":
            1,

        "view_id": [
            f"auto:cpf_{order_id}_lab_order",
        ],

        "toplevel_":
            True,

        "linkval": [
            f"ts:auto:cpf_{order_id}_lab_order",
        ],

        "children": [
            f"auto:LT{order_id}_TestSeries",
            f"auto:LT{order_id}_AllTests",
        ],
    }

    # ========================================================
    # LAB ORDER ATTRIBUTES
    # ========================================================

    mappings = [

        (
            "Lab Order Name",
            "title",
        ),

        (
            "Lab Order ID",
            "order_number",
        ),

        (
            "Report number",
            "report_number",
        ),

        (
            "Appendices",
            "appendices",
        ),

        (
            "Test code",
            "test_code",
        ),

        (
            "Order received",
            "order_received",
        ),

        (
            "Job number",
            "job_number",
        ),

        (
            "Test date",
            "test_date",
        ),

        (
            "Report date",
            "report_date",
        ),

        (
            "Material",
            "material",
        ),

        (
            "Heat number",
            "heat_number",
        ),

        (
            "COMTES job number",
            "comtes_job_number",
        ),

        (
            "Drawing number",
            "drawing_number",
        ),
    ]

    for (
        eda_name,
        crawler_name,
    ) in mappings:

        value = header_value(
            header,
            crawler_name,
        )

        if value == "":
            continue

        lab_order["attributes"].append(

            attribute(
                eda_name,
                text(value),
                valuetype="string",
            )
        )

    # ========================================================
    # WRITTEN BY
    # ========================================================

    if header.get("written_by"):

        lab_order["attributes"].append(

            attribute(
                "Written by",
                text(
                    header["written_by"]
                ),
                valuetype="string",
            )
        )

    # ========================================================
    # APPROVED BY
    # ========================================================

    if header.get("approved_by"):

        lab_order["attributes"].append(

            attribute(
                "Approved by",
                text(
                    header["approved_by"]
                ),
                valuetype="string",
            )
        )

    return lab_order


# ============================================================
# TEST SERIES
# ============================================================

def create_test_series(
    order_number: str,
    method: dict,
) -> tuple[dict, str]:

    test_key, test_series_name = (
        get_test_series_info(
            method
        )
    )

    order_id = slug(
        order_number
    )

    series_id = slug(
        test_series_name
    )

    series_name = (
        f"{order_number} - "
        f"{test_series_name}"
    )

    series = {

        "_id":
            f"auto:TS{order_id}_{series_id}",

        "itemid":
            f"auto:TS{order_id}_{series_id}",

        "unique_fields_": [
            "name",
        ],

        "link_id": [
            f"ts:{order_number}",
        ],

        "pid":
            order_number,

        "view_id": [
            series_name,
            (
                f"auto:cpf_"
                f"{order_id}_"
                f"ts_{test_key}"
            ),
        ],

        "name":
            series_name,

        "treetags": [
            (
                f"toplevel/"
                f"{order_id.replace('_', '-')}/"
                f"{series_id}"
            ),
        ],

        "viewtags": [
            "_generic",
        ],

        "permission_group":
            "allreadonly",

        "attributes": [
            attribute(
                "Lab Order",
                order_number,
                value_type="dblink",
            ),

            attribute(
                "Test Type",
                test_series_name,
            ),
        ],

        "type":
            "generic_test_series",

        "toplevel_":
            True,

        "children": [
            (
                f"auto:LT"
                f"{order_id}_"
                f"{test_key}_Tests"
            ),
        ],

        "visible_":
            "all",

        "version":
            1,

        "linkval": [
            f"test:ts:{series_name}",
        ],
    }

    # ========================================================
    # METHOD
    # ========================================================

    if method.get("name"):

        series["attributes"].append(

            attribute(
                "Method",
                text(
                    method["name"]
                ),
            )
        )

    # ========================================================
    # METHOD IDENTIFICATION
    # ========================================================

    if method.get("identification"):

        series["attributes"].append(

            attribute(
                "Method Identification",
                text(
                    method[
                        "identification"
                    ]
                ),
            )
        )

    # ========================================================
    # SPECIMEN TYPE
    # ========================================================

    if method.get("specimen_type"):

        series["attributes"].append(

            attribute(
                "Specimen Type",
                text(
                    method[
                        "specimen_type"
                    ]
                ),
            )
        )

    return (
        series,
        test_key,
    )


