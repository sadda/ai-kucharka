# ============================================================
# TEST
# ============================================================

def create_test(
    order_number: str,
    series_name: str,
    test_key: str,
    test_data: dict,
) -> dict:

    specimen = (
        text(
            test_data.get(
                "Specimen"
            )
        )
        or "Unnamed"
    )

    order_id = slug(
        order_number
    )

    specimen_id = slug(
        specimen
    )

    series_id = slug(
        series_name
    )

    test = {

        "_id":
            (
                f"auto:Test"
                f"{order_id}_"
                f"{specimen_id}"
            ),

        "itemid":
            (
                f"auto:Test"
                f"{order_id}_"
                f"{specimen_id}"
            ),

        "unique_fields_": [
            "name",
        ],

        # ====================================================
        # TEST JE NAPOJEN:
        #
        # 1. NA LAB ORDER
        # 2. NA TEST SERIES
        # ====================================================

        "link_id": [

            f"test:{order_number}",

            f"test:ts:{series_name}",
        ],

        "pid":
            order_number,

        "name":
            specimen,

        "treetags": [
            (
                f"toplevel/"
                f"{order_id.replace('_', '-')}/"
                f"{series_id}"
            ),
        ],

        "viewtags": [
            "_generic",
        ],

        "permission_group":
            "allreadonly",

        "attributes": [

            attribute(
                "Name",
                specimen,
            ),
        ],

        "type":
            "generic_test",

        "toplevel_":
            True,

        "children": [],

        "visible_":
            "all",

        "version":
            1,

        "view_id": [
            (
                f"auto:cpf_"
                f"{order_id}_"
                f"test_{specimen_id}"
            ),
        ],
    }

    # ========================================================
    # TEST TEMPERATURE
    # ========================================================

    if test_data.get(
        "Temp."
    ) not in (
        None,
        "",
    ):

        test["attributes"].append(

            attribute(
                "Test Temperature",
                number(
                    test_data[
                        "Temp."
                    ]
                ),
                unit="°C",
            )
        )

    # ========================================================
    # TEST SERIES
    # ========================================================

    test["attributes"].append(

        attribute(
            "Test Series",
            series_name,
            value_type="dblink",
        )
    )

    # ========================================================
    # VÝSLEDKY
    # ========================================================

    fields = get_test_fields(
        test_key
    )

    for (
        eda_name,
        crawler_name,
        unit,
    ) in fields:

        value = test_data.get(
            crawler_name
        )

        if value in (
            None,
            "",
        ):
            continue

        test["attributes"].append(

            attribute(
                eda_name,
                number(value),
                unit=unit,
            )
        )

    return test


# ============================================================
# SORTOVÁNÍ TESTŮ
# ============================================================

def specimen_sort_key(
    test: dict,
) -> tuple:

    name = text(
        test.get(
            "name",
            "",
        )
    )

    # --------------------------------------------------------
    # Příklad:
    #
    # 6827_1_1_L
    # 6827_1_2_L
    # 6827_2_1_L
    #
    # převedeme na:
    #
    # (6827, 1, 1, L)
    # --------------------------------------------------------

    parts = re.split(
        r"[_\-\s]+",
        name,
    )

    result = []

    for part in parts:

        if part.isdigit():

            result.append(
                (
                    0,
                    int(part),
                )
            )

        else:

            result.append(
                (
                    1,
                    part.lower(),
                )
            )

    return tuple(
        result
    )


# ============================================================
# HLAVNÍ CONVERT
# ============================================================

def convert(
    data: list[dict],
) -> list[dict]:

    if not isinstance(
        data,
        list,
    ):

        raise ValueError(
            "Input JSON musí obsahovat "
            "list protokolů."
        )

    if not data:
        return []

    # ========================================================
    # GROUP BY ORDER NUMBER
    # ========================================================

    grouped: dict[
        str,
        list[dict]
    ] = {}

    for record in data:

        header = record.get(
            "header",
            {},
        )

        order_number = header_value(
            header,
            "order_number",
        )

        if not order_number:

            raise ValueError(
                "Protokol nemá "
                "header.order_number."
            )

        grouped.setdefault(
            text(order_number),
            [],
        ).append(
            record
        )

    result = []

    # ========================================================
    # KAŽDÝ LAB ORDER
    # ========================================================

    for (
        order_number,
        records,
    ) in grouped.items():

        # ----------------------------------------------------
        # LAB ORDER
        # ----------------------------------------------------

        lab_order = create_lab_order(
            records[0],
            order_number,
        )

        result.append(
            lab_order
        )

        # ----------------------------------------------------
        # Series podle názvu
        # ----------------------------------------------------

        series_objects: dict[
            str,
            dict
        ] = {}

        # ----------------------------------------------------
        # Testy si nejdříve nasbíráme.
        #
        # Důležité kvůli správnému pořadí.
        # ----------------------------------------------------

        series_tests: dict[
            str,
            list[dict]
        ] = {}

        # ====================================================
        # PROTOKOLY
        # ====================================================

        for record in records:

            methods = record.get(
                "methods",
                [],
            )

            tests = record.get(
                "tests",
                {},
            )

            # =================================================
            # METODY / TEST SERIES
            # =================================================

            for method in methods:

                (
                    series,
                    test_key,
                ) = create_test_series(
                    order_number,
                    method,
                )

                series_name = (
                    series["name"]
                )

                # ---------------------------------------------
                # Series ještě neexistuje
                # ---------------------------------------------

                if (
                    series_name
                    not in series_objects
                ):

                    series_objects[
                        series_name
                    ] = series

                    series_tests[
                        series_name
                    ] = []

                # ---------------------------------------------
                # Test data
                # ---------------------------------------------

                test_list = tests.get(
                    test_key,
                    [],
                )

                for test_data in test_list:

                    test = create_test(
                        order_number,
                        series_name,
                        test_key,
                        test_data,
                    )

                    series_tests[
                        series_name
                    ].append(
                        test
                    )

        # ====================================================
        # SERIES + TESTS
        # ====================================================

        for (
            series_name,
            series,
        ) in series_objects.items():

            tests_for_series = (
                series_tests[
                    series_name
                ]
            )

            # ------------------------------------------------
            # Přirozené pořadí:
            #
            # 1_1
            # 1_2
            # 2_1
            # 2_2
            #
            # ------------------------------------------------

            tests_for_series.sort(
                key=specimen_sort_key
            )

            # ------------------------------------------------
            # Přidáme Series
            # ------------------------------------------------

            result.append(
                series
            )

            # ------------------------------------------------
            # Přidáme testy
            # ------------------------------------------------

            result.extend(
                tests_for_series
            )

    return result


# ============================================================
# MAIN
# ============================================================

def main() -> int:

    if len(sys.argv) != 3:

        print()
        print(
            "EDA CONVERTER 3000"
        )
        print()
        print(
            "Použití:"
        )
        print()
        print(
            "python EDAConverter3000.py "
            "INPUT.json OUTPUT.json"
        )
        print()
        print(
            "Příklad:"
        )
        print()
        print(
            "python EDAConverter3000.py "
            "results/cpf/en/55_26_C.json "
            "results/cpf/en/55_26_C_EDA_EN.json"
        )
        print()

        return 2

    input_path = Path(
        sys.argv[1]
    )

    output_path = Path(
        sys.argv[2]
    )

    # ========================================================
    # INPUT
    # ========================================================

    if not input_path.exists():

        print()
        print(
            "CHYBA:"
        )
        print(
            f"Soubor neexistuje:"
        )
        print(
            input_path
        )
        print()

        return 1

    # ========================================================
    # LOAD + CONVERT
    # ========================================================

    try:

        data = json.loads(

            input_path.read_text(
                encoding="utf-8"
            )
        )

        converted = convert(
            data
        )

        output_path.parent.mkdir(
            parents=True,
            exist_ok=True,
        )

        output_path.write_text(

            json.dumps(
                converted,
                ensure_ascii=False,
                indent=2,
            ),

            encoding="utf-8",
        )

    except Exception as error:

        print()
        print(
            "================================"
        )
        print(
            " CHYBA PŘI KONVERZI"
        )
        print(
            "================================"
        )
        print()
        print(
            error
        )
        print()

        return 1

    # ========================================================
    # SUMMARY
    # ========================================================

    print()
    print(
        "======================================"
    )
    print(
        "       EDA CONVERTER 3000"
    )
    print(
        "======================================"
    )
    print()

    print(
        f"INPUT :  {input_path}"
    )

    print(
        f"OUTPUT:  {output_path}"
    )

    print(
        f"OBJECTS: {len(converted)}"
    )

    print()
    print(
        "Hotovo."
    )
    print()

    return 0


# ============================================================
# START
# ============================================================

if __name__ == "__main__":

    raise SystemExit(
        main()
    )